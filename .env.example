# Copy to .env and set local development passwords before starting.
POSTGRES_DB=webshop
POSTGRES_USER=webshop
POSTGRES_PASSWORD=change-this-local-db-password
# 5433 avoids the existing PostgreSQL service on this machine.
POSTGRES_PORT=5433
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-local-admin-password
PGADMIN_PORT=5050
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
