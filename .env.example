# Copy to .env and set local development passwords before starting.
POSTGRES_DB=webshop
POSTGRES_USER=webshop
POSTGRES_PASSWORD=change-this-local-db-password
# 5433 avoids the existing PostgreSQL service on this machine.
POSTGRES_PORT=5433
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-local-admin-password
PGADMIN_PORT=5050
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Backend-only Geoapify key for reverse geocoding (lookup returns 503 if missing)
GEOAPIFY_API_KEY=

# Backend-only Braintree sandbox credentials. Never prefix these with VITE_.
# Use a replacement private key if a previous key was shared in chat.
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# Backend-only SMTP credentials (Brevo). EMAIL_FROM must be a verified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
